{
  "name": "Emojify-Recon — Rekonstruksi Ekspresi Alfanumerik",
  "short_name": "Emojify-Recon",
  "description": "Sistem rekonstruksi representasi visual berbasis emoji dari data alfanumerik A–Z, berjalan offline di browser.",
  "start_url": "./index.html",
  "scope": "./",
